# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.
# Use letters and digits only in passwords (they are placed inside URLs and JSON).

# Postgres (one server, two databases: "app" warehouse and "airflow" metadata)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=changemelocal
# Must match POSTGRES_USER / POSTGRES_PASSWORD above.
WAREHOUSE_URL=postgresql+psycopg://fitness:changemelocal@postgres:5432/app

# API
APP_TIMEZONE=Asia/Manila
# dev (this Mac and the LAN only), test, or production.
APP_ENV=dev
# Only honored when APP_ENV is dev or test (fixtures and screenshots); refused in production.
NOW_OVERRIDE=

# Sign-in (docs/AUTH_SPEC.md). The API refuses to start if these are unsafe for APP_ENV.
# google, or key (APP_ENV=dev only).
AUTH_MODE=key
# Where the browser opens the app. Google sign-in on the Mac: http://localhost:5173.
# Phone testing in dev: http://<mac-lan-ip>:5173 with AUTH_MODE=key.
PUBLIC_BASE_URL=http://localhost:5173
# Key-mode sign-in, dev only. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_LOGIN_KEY=change-me
# From Google Cloud Console > Clients (a Web application client). Never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the short-lived login cookie. At least 32 bytes.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_STATE_SECRET=change-me
# Your Google account's stable id. Sign in once; the denied attempt logs it (make logs).
# While it is empty, nobody can sign in with Google.
ALLOWED_GOOGLE_SUB=
# SHA-256 of the Shortcut's ingest token (the token itself stays on the phone).
# Generate both: python3 scripts/make_ingest_token.py
INGEST_TOKEN_SHA256=
# Optional, during rotation only: the hash of the next token.
INGEST_TOKEN_SHA256_NEXT=
# Hosting only (Slice 8): the reverse proxy's address, so Uvicorn trusts its
# X-Forwarded-For/-Proto. Never *. Unset here: Uvicorn then trusts 127.0.0.1 only.
FORWARDED_ALLOW_IPS=

# Strava (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
BACKFILL_DAYS=90

# Airflow UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changemelocal
