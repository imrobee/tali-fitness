# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.
# Use letters and digits only in passwords (they are placed inside URLs and JSON).

# Postgres (one server, two databases: "app" warehouse and "airflow" metadata)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=changemelocal
# Must match POSTGRES_USER / POSTGRES_PASSWORD above.
WAREHOUSE_URL=postgresql+psycopg://fitness:changemelocal@postgres:5432/app

# API
API_KEY=changemelocal
APP_TIMEZONE=Asia/Manila
APP_ENV=dev
# Only honored when APP_ENV is dev or test (fixtures and screenshots).
NOW_OVERRIDE=

# Strava (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
BACKFILL_DAYS=90

# Airflow UI login (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changemelocal
